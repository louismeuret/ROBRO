 229:Core/Src/main.c ****   /* USER CODE BEGIN 2 */
 230:Core/Src/main.c ****   /* Sinusoidal open-loop drive through the STGIPN3H60T IPM.
 231:Core/Src/main.c ****    *   PA8/PB13  = HIN1/LIN1 -> phase U
 232:Core/Src/main.c ****    *   PA9/PB14  = HIN2/LIN2 -> phase V
 233:Core/Src/main.c ****    *   PA10/PB15 = HIN3/LIN3 -> phase W
 234:Core/Src/main.c ****    * TIM1 produces the complementary HIN/LIN pairs with dead-time; the IPM
 235:Core/Src/main.c ****    * inputs are active-high. Motor_PWM_Update() (called from the TIM1 update
 236:Core/Src/main.c ****    * interrupt) drives each phase with a 120-degree-shifted sine, ramping
 237:Core/Src/main.c ****    * frequency and amplitude together -- a genuine rotating field, unlike
 238:Core/Src/main.c ****    * the previous equal-duty smoke test which produced zero line-to-line
 239:Core/Src/main.c ****    * voltage and no torque. */
 240:Core/Src/main.c **** 
 241:Core/Src/main.c ****   /* Hold PA5 (NSD_ADC) high at all times to keep the current/voltage-sense
 242:Core/Src/main.c ****    * signal conditioning out of shutdown. It defaults to a plain input;
 243:Core/Src/main.c ****    * override it to a push-pull output and drive it high. Set ODR high first
 244:Core/Src/main.c ****    * to avoid a glitch when the pin switches to output. */
 245:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);
 246:Core/Src/main.c ****   {
 247:Core/Src/main.c ****     GPIO_InitTypeDef pa5 = {0};
 248:Core/Src/main.c ****     pa5.Pin   = GPIO_PIN_5;
 249:Core/Src/main.c ****     pa5.Mode  = GPIO_MODE_OUTPUT_PP;
 250:Core/Src/main.c ****     pa5.Pull  = GPIO_NOPULL;
 251:Core/Src/main.c ****     pa5.Speed = GPIO_SPEED_FREQ_LOW;
 252:Core/Src/main.c ****     HAL_GPIO_Init(GPIOA, &pa5);
 253:Core/Src/main.c ****   }
 254:Core/Src/main.c **** 
 255:Core/Src/main.c ****   /* PB11 ("RS") is NOT a digital IPM enable pin: it feeds an RC filter
 256:Core/Src/main.c ****    * (R12/C16) into the IPM's CIN pin, the analog overcurrent-comparator
 257:Core/Src/main.c ****    * input that gates the U-channel driver specifically. Driving it high
 258:Core/Src/main.c ****    * holds CIN above its trip threshold, permanently faulting out U while
 259:Core/Src/main.c ****    * leaving V/W unaffected. Keep it low so CIN stays below threshold.
ARM GAS  /tmp/ccDTSleZ.s 			page 6


 260:Core/Src/main.c ****    * NOTE: this also means the IPM's own overcurrent comparator can never
 261:Core/Src/main.c ****    * trip (CIN is held below threshold at all times) -- there is no
 262:Core/Src/main.c ****    * hardware or software current protection on this drive. */
 263:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOB, GPIO_PIN_11, GPIO_PIN_RESET);
 264:Core/Src/main.c **** 
 265:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
 266:Core/Src/main.c ****   HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_1);
 267:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
 268:Core/Src/main.c ****   HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_2);
 269:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_3);
 270:Core/Src/main.c ****   HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_3);
 271:Core/Src/main.c ****   HAL_TIM_Base_Start_IT(&htim1);
 272:Core/Src/main.c **** 
 273:Core/Src/main.c ****   /* RS485 daisy-chain ping/pong discovery (USART2, shared bus over both
 274:Core/Src/main.c ****    * RJ45 jacks). */
 275:Core/Src/main.c ****   DaisyChain_Init();
 276:Core/Src/main.c **** 
 277:Core/Src/main.c ****   /* ESP32 telemetry/command link on SPI1 (PB3/PB4/PA7 + PB9 as CS). Also
 278:Core/Src/main.c ****    * calibrates ADC1 and ADC2 -- they were initialised by CubeMX but never
 279:Core/Src/main.c ****    * calibrated or started. */
 280:Core/Src/main.c ****   Esp_Init();
 281:Core/Src/main.c ****   /* USER CODE END 2 */
 282:Core/Src/main.c **** 
 283:Core/Src/main.c ****   /* Infinite loop */
 284:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 285:Core/Src/main.c ****   while (1)
 286:Core/Src/main.c ****   {
 287:Core/Src/main.c ****     /* USER CODE END WHILE */
 288:Core/Src/main.c **** 
 289:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 290:Core/Src/main.c ****     /* 15V-supply status housekeeping (preserved from the smoke test).
 291:Core/Src/main.c ****      * PA15 (Fault_15V) high -> no 15V. The state is also published in the
 292:Core/Src/main.c ****      * telemetry frame so the ESP32 dashboard can show it. */
 293:Core/Src/main.c ****     fault_15v = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_15) == GPIO_PIN_SET) ? 1u : 0u;
 294:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, fault_15v ? GPIO_PIN_SET : GPIO_PIN_RESET);
 295:Core/Src/main.c ****     Leds_Apply();
 296:Core/Src/main.c **** 
 297:Core/Src/main.c ****     /* U/V/W duty is updated from the TIM1 update interrupt (Motor_PWM_Update) —
 298:Core/Src/main.c ****      * nothing to do for the motor drive here. */
 299:Core/Src/main.c ****     DaisyChain_Poll();
 300:Core/Src/main.c ****     Esp_Poll();
 301:Core/Src/main.c ****   }
 302:Core/Src/main.c ****   /* USER CODE END 3 */
 303:Core/Src/main.c **** }

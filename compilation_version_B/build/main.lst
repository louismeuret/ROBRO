  34:Core/Src/main.c **** 
  35:Core/Src/main.c **** /* ----- Open-loop V/Hz sinusoidal drive (STGIPN3H60T IPM, Mitsubishi
  36:Core/Src/main.c ****  * HC-KFS13 PMSM servo) -----
  37:Core/Src/main.c ****  * TIM1 timer clock = 16 MHz, center-aligned: f_pwm = 16e6 / (2 * PWM_ARR).
  38:Core/Src/main.c ****  * PWM_ARR = 400 -> 20 kHz PWM. */
  39:Core/Src/main.c **** #define PWM_ARR                  400u
  40:Core/Src/main.c **** 
  41:Core/Src/main.c **** /* HC-KFS13 is a 100 W, 200 Vac-class PMSM (0.71 A / 3000 r/min rated, per
  42:Core/Src/main.c ****  * Mitsubishi's published specs). Its exact pole-pair count isn't in the
  43:Core/Src/main.c ****  * generally available manuals; 4 pole pairs (8 poles) is typical for this
  44:Core/Src/main.c ****  * small low-inertia Mitsubishi servo class and used below purely to relate
  45:Core/Src/main.c ****  * electrical frequency to an approximate mechanical speed in comments --
  46:Core/Src/main.c ****  * open-loop drive correctness doesn't depend on it. Verify against the
  47:Core/Src/main.c ****  * motor nameplate/manual if the exact RPM matters. */
  48:Core/Src/main.c **** #define MOTOR_POLE_PAIRS         4u
  49:Core/Src/main.c **** 
  50:Core/Src/main.c **** /* One electrical cycle, values in [-1, 1]. 96 so that a 120-degree phase
  51:Core/Src/main.c ****  * shift is an exact 32-sample index offset (96 / 3), avoiding any
  52:Core/Src/main.c ****  * interpolation/rounding error between the three phases. */
  53:Core/Src/main.c **** #define SINE_LUT_SIZE            96u
  54:Core/Src/main.c **** 
  55:Core/Src/main.c **** /* TIM1 runs center-aligned, so the update event fires on both the up- and
  56:Core/Src/main.c ****  * down-count each PWM period -> 2x the 20 kHz carrier. */
  57:Core/Src/main.c **** #define PWM_UPDATE_HZ            40000.0f
  58:Core/Src/main.c **** #define LUT_STEP_PER_HZ          ((float)SINE_LUT_SIZE / PWM_UPDATE_HZ)
  59:Core/Src/main.c **** 
  60:Core/Src/main.c **** /* Open-loop start-up ramp: electrical frequency ramps 0 -> ELEC_FREQ_TARGET_HZ
  61:Core/Src/main.c ****  * over RAMP_TIME_S seconds; modulation index (PWM duty amplitude) ramps
  62:Core/Src/main.c ****  * alongside it from a fixed low-speed boost (M_START, to overcome resistive
  63:Core/Src/main.c ****  * drop/static friction while electrical frequency is near 0) up to
  64:Core/Src/main.c ****  * M_TARGET. No encoder feedback and no current limiting: this only proves
  65:Core/Src/main.c ****  * the waveform is a genuine rotating field, it is not closed-loop servo
  66:Core/Src/main.c ****  * control. Keep M_TARGET conservative until current has been verified on
  67:Core/Src/main.c ****  * the phase shunts (IU/IV/IW) with a scope. */
  68:Core/Src/main.c **** #define ELEC_FREQ_TARGET_HZ      20.0f     /* -> ~300 r/min @ 4 pole pairs */
  69:Core/Src/main.c **** #define RAMP_TIME_S              5.0f
  70:Core/Src/main.c **** #define M_START                  0.10f
  71:Core/Src/main.c **** #define M_TARGET                 0.80f
  72:Core/Src/main.c **** #define RAMP_STEP_PER_TICK       (1.0f / (RAMP_TIME_S * PWM_UPDATE_HZ))
  73:Core/Src/main.c **** 
  74:Core/Src/main.c **** /* ----- RS485 daisy-chain ping/pong (USART2, shared TX/RX bus over both
  75:Core/Src/main.c ****  * RJ45 jacks) ----- */
  76:Core/Src/main.c **** #define DC_FRAME_LEN             8u
  77:Core/Src/main.c **** #define DC_SYNC0                 0xAAu
  78:Core/Src/main.c **** #define DC_SYNC1                 0x55u
  79:Core/Src/main.c **** #define DC_TYPE_PING             0x01u
  80:Core/Src/main.c **** #define DC_TYPE_PONG             0x02u
  81:Core/Src/main.c **** #define DC_PING_PERIOD_MS        1000u
  82:Core/Src/main.c **** #define DC_LED_BLINK_MS          80u
  83:Core/Src/main.c **** #define DC_RX_BUF_LEN            64u
  84:Core/Src/main.c **** #define DC_MAX_PEERS             4u     /* boards remembered in the peer table */
  85:Core/Src/main.c **** 
  86:Core/Src/main.c **** /* ----- ESP32 telemetry / command link (SPI1, STM32 is master) -----
  87:Core/Src/main.c ****  * All four signals land on the board's existing header, so nothing has to be
  88:Core/Src/main.c ****  * soldered to the LED pads:
ARM GAS  /tmp/ccDTSleZ.s 			page 3


  89:Core/Src/main.c ****  *
  90:Core/Src/main.c ****  *   PB3 (GPIO4, SPI_SCK)  -> ESP32 SCLK
  91:Core/Src/main.c ****  *   PA7 (GPIO6, SPI_MOSI) -> ESP32 MOSI   (telemetry out)
  92:Core/Src/main.c ****  *   PB4 (GPIO5, SPI_MISO) <- ESP32 MISO   (commands in)
  93:Core/Src/main.c ****  *   PB9 (free header pin) -> ESP32 CS     (software NSS, active low)
  94:Core/Src/main.c ****  *   GND                   -- GND
  95:Core/Src/main.c ****  *
  96:Core/Src/main.c ****  * SPI was chosen because it is the only full-duplex link available on the
  97:Core/Src/main.c ****  * reachable pins: PB3/PB4/PA14 all map to USART2, which is already driving the
  98:Core/Src/main.c ****  * RS485 daisy chain, and PB9's UART partner (USART3_RX) is PB8-BOOT0.
  99:Core/Src/main.c ****  *
 100:Core/Src/main.c ****  * SPI1 was already configured by CubeMX as a full-duplex master with soft NSS
 101:Core/Src/main.c ****  * and never used. Two changes are needed: 8-bit words instead of 4, and a
 102:Core/Src/main.c ****  * slower clock -- 8 MHz is more than an ESP32 SPI slave will follow reliably.
 103:Core/Src/main.c ****  *
 104:Core/Src/main.c ****  * The exchange is symmetric and fixed length: every transfer clocks a
 105:Core/Src/main.c ****  * telemetry frame out on MOSI while a command frame arrives on MISO. */
 106:Core/Src/main.c **** #define ESP_FRAME_LEN            72u
 107:Core/Src/main.c **** #define ESP_PERIOD_MS            50u    /* 20 exchanges per second */
 108:Core/Src/main.c **** 
 109:Core/Src/main.c **** #define ESP_TX_SYNC0             0xA5u  /* STM32 -> ESP32 (telemetry) */
 110:Core/Src/main.c **** #define ESP_TX_SYNC1             0x5Au
 111:Core/Src/main.c **** #define ESP_RX_SYNC0             0xC3u  /* ESP32 -> STM32 (command)   */
 112:Core/Src/main.c **** #define ESP_RX_SYNC1             0x3Cu
 113:Core/Src/main.c **** 
 114:Core/Src/main.c **** #define ESP_CMD_NOP              0x00u
 115:Core/Src/main.c **** #define ESP_CMD_SET_FREQ         0x01u  /* arg = centi-Hz      */
 116:Core/Src/main.c **** #define ESP_CMD_SET_MOD          0x02u  /* arg = milli-units   */
 117:Core/Src/main.c **** #define ESP_CMD_START            0x03u
 118:Core/Src/main.c **** #define ESP_CMD_STOP             0x04u
 119:Core/Src/main.c **** #define ESP_CMD_PING             0x05u
 120:Core/Src/main.c **** #define ESP_CMD_SET_MOD_START    0x06u  /* arg = milli-units   */
 121:Core/Src/main.c **** #define ESP_CMD_SET_RAMP_MS      0x07u  /* arg = milliseconds  */
 122:Core/Src/main.c **** #define ESP_CMD_SET_DIR          0x08u  /* arg = 0 fwd, 1 rev  */
 123:Core/Src/main.c **** #define ESP_CMD_SET_LED          0x09u  /* arg lo = led index, hi = mode */
 124:Core/Src/main.c **** 
 125:Core/Src/main.c **** /* LED override modes for ESP_CMD_SET_LED. */
 126:Core/Src/main.c **** #define ESP_LED_AUTO             0u
 127:Core/Src/main.c **** #define ESP_LED_ON               1u
 128:Core/Src/main.c **** #define ESP_LED_OFF              2u
 129:Core/Src/main.c **** #define ESP_LED_COUNT            2u     /* 0 = LED1 (PB6), 1 = LED2 (PB7) */
 130:Core/Src/main.c **** 
 131:Core/Src/main.c **** #define ESP_CS_PORT              GPIOB
 132:Core/Src/main.c **** #define ESP_CS_PIN               GPIO_PIN_9
 133:Core/Src/main.c **** 
 134:Core/Src/main.c **** /* The ESP32 slave needs CS stable a little before the first clock edge and
 135:Core/Src/main.c ****  * after the last. ~1 us at 16 MHz; HAL_Delay's 1 ms granularity is far too
 136:Core/Src/main.c ****  * coarse for this. */
 137:Core/Src/main.c **** #define ESP_CS_SETTLE()          do { for (volatile uint32_t i_ = 0; i_ < 16u; i_++) { __NOP(); } }
 138:Core/Src/main.c **** 

 168:Core/Src/main.c ****   /* Sinusoidal open-loop drive through the STGIPN3H60T IPM.
 169:Core/Src/main.c ****    *   PA8/PB13  = HIN1/LIN1 -> phase U
 170:Core/Src/main.c ****    *   PA9/PB14  = HIN2/LIN2 -> phase V
 171:Core/Src/main.c ****    *   PA10/PB15 = HIN3/LIN3 -> phase W
 172:Core/Src/main.c ****    * TIM1 produces the complementary HIN/LIN pairs with dead-time; the IPM
 173:Core/Src/main.c ****    * inputs are active-high. Motor_PWM_Update() (called from the TIM1 update
 174:Core/Src/main.c ****    * interrupt) drives each phase with a 120-degree-shifted sine, ramping
 175:Core/Src/main.c ****    * frequency and amplitude together -- a genuine rotating field, unlike
 176:Core/Src/main.c ****    * the previous equal-duty smoke test which produced zero line-to-line
 177:Core/Src/main.c ****    * voltage and no torque. */
 178:Core/Src/main.c **** 
 179:Core/Src/main.c ****   /* Hold PA5 (NSD_ADC) high at all times to keep the current/voltage-sense
 180:Core/Src/main.c ****    * signal conditioning out of shutdown. It defaults to a plain input;
 181:Core/Src/main.c ****    * override it to a push-pull output and drive it high. Set ODR high first
 182:Core/Src/main.c ****    * to avoid a glitch when the pin switches to output. */
 183:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);
 184:Core/Src/main.c ****   {
 185:Core/Src/main.c ****     GPIO_InitTypeDef pa5 = {0};
 186:Core/Src/main.c ****     pa5.Pin   = GPIO_PIN_5;
 187:Core/Src/main.c ****     pa5.Mode  = GPIO_MODE_OUTPUT_PP;
 188:Core/Src/main.c ****     pa5.Pull  = GPIO_NOPULL;
 189:Core/Src/main.c ****     pa5.Speed = GPIO_SPEED_FREQ_LOW;
 190:Core/Src/main.c ****     HAL_GPIO_Init(GPIOA, &pa5);
 191:Core/Src/main.c ****   }
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****   /* PB11 ("RS") is NOT a digital IPM enable pin: it feeds an RC filter
 194:Core/Src/main.c ****    * (R12/C16) into the IPM's CIN pin, the analog overcurrent-comparator
 195:Core/Src/main.c ****    * input that gates the U-channel driver specifically. Driving it high
 196:Core/Src/main.c ****    * holds CIN above its trip threshold, permanently faulting out U while
 197:Core/Src/main.c ****    * leaving V/W unaffected. Keep it low so CIN stays below threshold.
 198:Core/Src/main.c ****    * NOTE: this also means the IPM's own overcurrent comparator can never
 199:Core/Src/main.c ****    * trip (CIN is held below threshold at all times) -- there is no
 200:Core/Src/main.c ****    * hardware or software current protection on this drive. */
 201:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOB, GPIO_PIN_11, GPIO_PIN_RESET);
 202:Core/Src/main.c **** 
ARM GAS  /tmp/ccJEd6FX.s 			page 5


 203:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
 204:Core/Src/main.c ****   HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_1);
 205:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
 206:Core/Src/main.c ****   HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_2);
 207:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_3);
 208:Core/Src/main.c ****   HAL_TIMEx_PWMN_Start(&htim1, TIM_CHANNEL_3);
 209:Core/Src/main.c ****   HAL_TIM_Base_Start_IT(&htim1);
 210:Core/Src/main.c **** 
 211:Core/Src/main.c ****   /* RS485 daisy-chain ping/pong discovery (USART2, shared bus over both
 212:Core/Src/main.c ****    * RJ45 jacks). */
 213:Core/Src/main.c ****   DaisyChain_Init();
 214:Core/Src/main.c ****   /* USER CODE END 2 */
 215:Core/Src/main.c **** 
 216:Core/Src/main.c ****   /* Infinite loop */
 217:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 218:Core/Src/main.c ****   while (1)
 219:Core/Src/main.c ****   {
 220:Core/Src/main.c ****     /* USER CODE END WHILE */
 221:Core/Src/main.c **** 
 222:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 223:Core/Src/main.c ****     /* 15V-supply status housekeeping (preserved from the smoke test). */
 224:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_15) == GPIO_PIN_SET)
 225:Core/Src/main.c ****     {
 226:Core/Src/main.c ****       /* PA15 (Fault_15V) high -> no 15V */
 227:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, GPIO_PIN_SET);
 228:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_RESET);
 229:Core/Src/main.c ****     }
 230:Core/Src/main.c ****     else
 231:Core/Src/main.c ****     {
 232:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, GPIO_PIN_RESET);
 233:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_SET);
 234:Core/Src/main.c ****     }
 235:Core/Src/main.c **** 
 236:Core/Src/main.c ****     /* U/V/W duty is updated from the TIM1 update interrupt (Motor_PWM_Update) —
 237:Core/Src/main.c ****      * nothing to do for the motor drive here. */
 238:Core/Src/main.c ****     DaisyChain_Poll();
 239:Core/Src/main.c ****   }
 240:Core/Src/main.c ****   /* USER CODE END 3 */
 241:Core/Src/main.c **** }

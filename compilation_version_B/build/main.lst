 926:Core/Src/main.c ****   frame[5] = (uint8_t)(board_id >> 16);
 927:Core/Src/main.c ****   frame[6] = (uint8_t)(board_id >> 24);
 928:Core/Src/main.c ****   frame[7] = (uint8_t)(frame[2] ^ frame[3] ^ frame[4] ^ frame[5] ^ frame[6]);

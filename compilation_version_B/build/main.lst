 896:Core/Src/main.c ****   }
 897:Core/Src/main.c **** 
 898:Core/Src/main.c ****   if (dc_peer_count < DC_MAX_PEERS)
 899:Core/Src/main.c ****   {
 900:Core/Src/main.c ****     dc_peer_id[dc_peer_count] = id;
 901:Core/Src/main.c ****     dc_peer_seen[dc_peer_count] = now;

1040:Core/Src/main.c **** /* ===== ESP32 telemetry / command link (SPI1 master, PB3/PB4/PA7 + PB9 CS) ==
1041:Core/Src/main.c ****  *
1042:Core/Src/main.c ****  * One fixed-length full-duplex transfer per period: the telemetry frame is
1043:Core/Src/main.c ****  * clocked out on MOSI while the ESP32's command frame arrives on MISO. The
1044:Core/Src/main.c ****  * ESP32 runs as an SPI slave and stages its reply before the transfer starts,
1045:Core/Src/main.c ****  * so the command it returns is always the one it prepared last time round --
1046:Core/Src/main.c ****  * that one-frame lag is why commands carry a sequence number.
1047:Core/Src/main.c ****  *
1048:Core/Src/main.c ****  * Telemetry frame (STM32 -> ESP32), 72 bytes, little-endian:
1049:Core/Src/main.c ****  *    0     0xA5 sync
1050:Core/Src/main.c ****  *    1     0x5A sync
1051:Core/Src/main.c ****  *    2-3   VDC        4-5   VU        6-7   VV (always 0)
1052:Core/Src/main.c ****  *    8-9   VW        10-11  IU       12-13  IV       14-15  IW
1053:Core/Src/main.c ****  *    16    flags: bit0 = 15V fault, bit1 = outputs enabled,
1054:Core/Src/main.c ****  *                 bit2 = reverse, bit3 = PB10 input level
1055:Core/Src/main.c ****  *    17    number of daisy-chain peers in the table
1056:Core/Src/main.c ****  *    18-21 total RS485 frames seen from other boards
1057:Core/Src/main.c ****  *    22-23 electrical frequency setpoint, centi-Hz
1058:Core/Src/main.c ****  *    24-25 modulation index target, milli-units
1059:Core/Src/main.c ****  *    26-29 this board's id
1060:Core/Src/main.c ****  *    30-31 modulation index at start of ramp, milli-units
1061:Core/Src/main.c ****  *    32-33 ramp time, milliseconds
1062:Core/Src/main.c ****  *    34-35 live ramp progress, milli (0..1000)
ARM GAS  /tmp/ccDTSleZ.s 			page 25


1063:Core/Src/main.c ****  *    36-37 PWM_ARR (carrier = 16 MHz / (2 * ARR))
1064:Core/Src/main.c ****  *    38    LED1 mode      39   LED2 mode   (0 auto, 1 on, 2 off)
1065:Core/Src/main.c ****  *    40-63 peer table: 4 entries of { u32 id, u16 age in 10 ms units }
1066:Core/Src/main.c ****  *    64-69 reserved
1067:Core/Src/main.c ****  *    70    XOR checksum of bytes 0..69
1068:Core/Src/main.c ****  *    71    padding
1069:Core/Src/main.c ****  *
1070:Core/Src/main.c ****  * Command frame (ESP32 -> STM32), 72 bytes:
1071:Core/Src/main.c ****  *    0     0xC3 sync
1072:Core/Src/main.c ****  *    1     0x3C sync
1073:Core/Src/main.c ****  *    2     command id
1074:Core/Src/main.c ****  *    3     sequence number -- acted on only when it changes
1075:Core/Src/main.c ****  *    4-5   argument
1076:Core/Src/main.c ****  *    6-70  reserved
1077:Core/Src/main.c ****  *    71    XOR checksum of bytes 0..70
1078:Core/Src/main.c ****  */
1079:Core/Src/main.c **** 
1080:Core/Src/main.c **** static uint8_t esp_tx_frame[ESP_FRAME_LEN];
